{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "MassTransit": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": true,
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "ApiDocs": {
    "Enabled": false
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "Messaging": {
    "Queues": {
      "OrderPlaced": "payments.order-placed"
    },
    "PrefetchCount": 16,
    "ConcurrentMessageLimit": 8
  },
  "Jwt": {
    "Issuer": "fcg-users-api",
    "Audience": "fcg",
    "RequireHttpsMetadata": false
  },
  "PaymentSimulation": {
    "MaxApprovedAmount": 300.0,
    "ProcessingDelayMs": 1500
  }
}
